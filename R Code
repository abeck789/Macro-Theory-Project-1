# Choose Ireland and divide the data into periods
ireland_data <- data %>%
  filter(Country == "Ireland") %>%
  mutate(
    Period = case_when(
      YEAR < 1990 ~ "Pre-1990",
      YEAR >= 1990 & YEAR <= 2007 ~ "1990-2007",
      YEAR >= 2008 ~ "2008 onward"
    )
  )

# View the observations by period
ireland_data %>%
  select(Country, YEAR, GDP_pc, GDP_Growth, Period) %>%
  arrange(YEAR)

ireland_summary <- ireland_data %>%
  group_by(Period) %>%
  summarise(
    average_GDP_growth = mean(GDP_Growth, na.rm = TRUE),
    growth_volatility = sd(GDP_Growth, na.rm = TRUE),
    average_GDP_pc = mean(GDP_pc, na.rm = TRUE),
    observations = n(),
    .groups = "drop"
  )

