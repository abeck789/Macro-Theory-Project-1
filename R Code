install.packages("WDI")
install.packages("GGally")
library(WDI)
library(dplyr)
library(ggplot2)
library(GGally)

# OECD member countries
oecd_codes <- c(
  "AUS", "AUT", "BEL", "CAN", "CHL", "COL", "CRI", "CZE", "DNK",
  "EST", "FIN", "FRA", "DEU", "GRC", "HUN", "ISL", "IRL", "ISR",
  "ITA", "JPN", "KOR", "LVA", "LTU", "LUX", "MEX", "NLD", "NZL",
  "NOR", "POL", "PRT", "SVK", "SVN", "ESP", "SWE", "CHE", "TUR",
  "GBR", "USA"
)

# Download annual OECD data
oecd_data <- WDI(
  country = oecd_codes,
  indicator = c(
    GDP_Growth = "NY.GDP.PCAP.KD.ZG",
    Pop_Growth = "SP.POP.GROW",
    Investment = "NE.GDI.TOTL.ZS",
    Human_Capital = "SE.TER.ENRR"
  ),
  start = 1990,
  end = 2023,
  extra = TRUE
) %>%
  filter(iso3c %in% oecd_codes) %>%
  select(country, iso3c, year, GDP_Growth, Pop_Growth,
         Investment, Human_Capital)

# Keep observations with all variables available
oecd_complete <- oecd_data %>%
  filter(complete.cases(GDP_Growth, Pop_Growth,
                        Investment, Human_Capital))

# Correlation matrix
cor_matrix <- oecd_complete %>%
  select(GDP_Growth, Pop_Growth, Investment, Human_Capital) %>%
  cor()

round(cor_matrix, 2)

